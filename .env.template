# Container image for this Jetson device
CONTAINER = nvcr.io/nvidia/l4t-ml:r36.2.0-py3

# Measurement Options 
# Note: Use the `extract_env_var` function in the code to read these values with proper types. 
rail=VIN_SYS_5V0
interval_ms=50
log_dir=powerlogs
num_runs=5
guard_samples=3
energy_csv_path=energy_results.csv
append=True
also_write_log_file=True
fallback_rails=POM_5V_IN,VDD_CPU_CV,VDD_GPU_SOC